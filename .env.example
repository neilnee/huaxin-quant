# Required for live financial data requests.
MX_APIKEY=

# Required by scripts/run_pool.py unless --skip-fetch or --dry-run is used.
HUAXIN_XUANGU_SCRIPT=/path/to/mx_xuangu.py

# Optional: enables LLM-generated review output where supported.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional engineering controls.
# Maximum lifetime of one daily pipeline subprocess (default: 21600 = 6 hours).
HUAXIN_STAGE_TIMEOUT_SECONDS=21600

# Optional: rebuild the Eastmoney watchlist after a successful daily run.
ENABLE_ZIXUAN_SYNC=false
