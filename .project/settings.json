{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(tmp_*/**)",
      "Write(tmp_*/**)",
      "Edit(tmp_*/**)"
    ],
    "deny": [
      "Read(.env)",
      "Write(.env)",
      "Edit(.env)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git push *)"
    ]
  }
}
