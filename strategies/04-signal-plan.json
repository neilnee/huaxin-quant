  "pullback_follow": {
    "trigger_low_ratio": 0.96,
    "trigger_high_ratio": 1.03,
    "ideal_low_ratio": 0.995,
    "ideal_high_ratio": 1.01,
    "volume_max_ratio": 0.9,
    "ideal_volume_max_ratio": 0.8,
    "invalid_anchor_ratio": 0.97,
    "invalid_low_ratio": 0.98
  },
  "retest_buy": {
    "trigger_low_ratio": 0.99,
    "trigger_high_ratio": 1.005,
