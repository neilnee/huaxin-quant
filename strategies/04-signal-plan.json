    "volume_ma20_ratio": 1.0,
    "volume_ma5_ratio": 1.0,
    "ideal_volume_min_ratio": 1.5,
    "invalid_pivot_ratio": 0.97
  },
  "breakout_follow": {
    "close_buffer_ratio": 1.01,
    "max_close_extension_ratio": 1.08,
    "ideal_low_ratio": 1.02,
    "ideal_high_ratio": 1.05,
    "overextended_ratio": 1.08,
    "volume_ma20_ratio": 1.0,
    "volume_ma5_ratio": 1.0,
    "ideal_volume_min_ratio": 1.5,
    "invalid_pivot_ratio": 0.98
  },
  "pullback_buy": {
    "support_anchor_order": [
      "MA20",
      "MA60",
      "last_contraction_low",
      "support_price"
    ],
    "trigger_low_ratio": 0.96,
    "trigger_high_ratio": 1.03,
    "ideal_low_ratio": 0.995,
    "ideal_high_ratio": 1.015,
    "volume_max_ratio": 0.9,
    "ideal_volume_max_ratio": 0.8,
    "invalid_anchor_ratio": 0.97,
    "invalid_low_ratio": 0.98
