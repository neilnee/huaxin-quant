{
  "strategy_version": "model4_signal_plan_v1",
  "description": "Signal Plan parameters. This model-4 signal layer consumes Model 2 quant JSON and emits next-session concrete price/volume setup plans.",
  "inputs": {
    "quant_run_dir": "cache/quant_runs"
  },
  "outputs": {
    "plan_dir": "signal_plan"
  },
  "candidate_rules": {
    "allowed_new_stages": [
      "VCP_MATURE",
      "VCP_TIGHT"
    ],
    "allowed_follow_signals": [
      "PULLBACK_BUY",
      "BREAKOUT_BUY",
      "RETEST_BUY"
    ],
    "min_structure_score": 60.0,
    "risk_block_min_score": 40.0,
    "hard_risk_flags": [
      "OVERHEAT_CHG5",
      "OVERHEAT_CHG20",
      "DOWNTREND",
      "DEEP_FALL"
    ]
  },
  "quality_rules": {
    "A": {
      "min_structure_score": 80.0,
      "max_risk_score": 15.0
    },
    "B": {
      "min_structure_score": 65.0,
      "max_risk_score": 30.0
    },
    "main_table_qualities": [
      "A",
      "B"
    ]
  },
  "breakout_buy": {
    "close_buffer_ratio": 1.01,
    "max_close_extension_ratio": 1.08,
