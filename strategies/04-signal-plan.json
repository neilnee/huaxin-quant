{
  "strategy_version": "model4_signal_plan_v5",
  "description": "Signal Plan parameters. This model-4 signal layer consumes Model 2 quant JSON and emits next-session concrete price/volume setup plans.",
  "inputs": {
    "quant_run_dir": "cache/quant_runs"
  },
  "outputs": {
    "plan_dir": "signal_plan"
  },
  "candidate_rules": {
    "allowed_new_stages": [
      "VCP_FORMING",
      "VCP_MATURE",
      "VCP_TIGHT"
    ],
    "allowed_follow_signals": [
      "PULLBACK_BUY",
      "BREAKOUT_BUY",
      "RETEST_BUY"
    ],
    "forming_new_gate": {
      "min_structure_score": 80.0,
      "max_risk_score": 15.0,
      "allowed_volume_patterns": ["decreasing", "drying"],
      "min_pivot_distance_pct": -8.0,
      "required_post_breakout_state": "PRE_BREAKOUT"
    },
    "min_structure_score": 60.0,
    "risk_block_min_score": 40.0,
    "hard_risk_flags": [
      "OVERHEAT_CHG5",
      "OVERHEAT_CHG20",
      "DOWNTREND",
      "DEEP_FALL"
    ]
  },
  "quality_rules": {
    "A": {
      "min_structure_score": 80.0,
      "max_risk_score": 15.0
    },
    "B": {
      "min_structure_score": 65.0,
      "max_risk_score": 30.0
    },
    "main_table_qualities": [
      "A",
      "B"
    ]
  },
  "position_guidance": {
    "eligible_setup_qualities": ["A", "B"],
    "base_position_pct": {
      "PULLBACK_BUY": {"A": [20, 30], "B": [10, 20]},
      "BREAKOUT_BUY": {"A": [40, 50], "B": [20, 30]},
      "RETEST_BUY": {"A": [60, 80], "B": [40, 50]}
    },
    "sector_groups": {
      "STRONG": ["持续主线", "新晋强化", "强势初现"],
      "NEUTRAL": ["轮动脉冲", "高位分歧"],
      "BLOCKED": ["观察中", "历史积累中", "弱势退潮"]
    },
    "environment_factors": {
      "OFFENSIVE": {"STRONG": 1.0, "NEUTRAL": 0.7, "BLOCKED": 0.0},
      "SELECTIVE": {"STRONG": 1.0, "NEUTRAL": 0.5, "BLOCKED": 0.0},
      "RECOVERY_WATCH": {"STRONG": 0.7, "NEUTRAL": 0.3, "BLOCKED": 0.0},
      "CONSOLIDATING": {"STRONG": 0.0, "NEUTRAL": 0.0, "BLOCKED": 0.0},
      "DEFENSIVE": {"STRONG": 0.0, "NEUTRAL": 0.0, "BLOCKED": 0.0}
    },
    "unknown_sector_group": "BLOCKED",
    "unknown_environment_factor": 0.0,
    "rounding_step_pct": 5
  },
  "capital_support": {
    "lookback_trade_days": 5,
    "default_maximum_requests_per_publish": 5,
    "hard_maximum_requests_per_publish": 10
  },
  "breakout_buy": {
    "close_buffer_ratio": 1.01,
    "max_close_extension_ratio": 1.08,
    "ideal_low_ratio": 1.02,
    "ideal_high_ratio": 1.05,
